{
  "manifest_version": 3,
  "name": "Calmfeed - Clean LinkedIn Feed",
  "short_name": "Calmfeed",
  "version": "1.0.0",
  "description": "Hide promoted posts, suggested posts, polls, 'X liked this' noise and muted keywords from your LinkedIn feed.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Calmfeed",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": ["storage"],
  "content_scripts": [
    {
      "matches": ["https://extensionpay.com/*"],
      "js": ["ExtPay.js"],
      "run_at": "document_start"
    },
    {
      "matches": ["https://www.linkedin.com/*"],
      "js": ["config.js", "content.js"],
      "run_at": "document_start"
    }
  ]
}
